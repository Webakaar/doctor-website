# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-long-random-secret-in-production

# Supabase (Optional in local demo mode; required for production Supabase PostgreSQL + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Classic legacy names are also supported:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Optional in local demo mode; when omitted, built-in Razorpay Test Simulator runs)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP / Nodemailer - can also be configured in Admin -> Notification Settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AuraCare Hospital
SMTP_FROM_EMAIL=appointments@auracarehospital.example

# MSG91 SMS & WhatsApp (can also be configured in Admin -> Notification Settings)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AURACR
MSG91_SMS_TEMPLATE_ID=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=
